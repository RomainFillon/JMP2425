# .gitignore of the replication package.
# In: code, the checks the chain runs, manifests, small inputs the code cannot download,
#     the paper's outputs, the manuscript and its bibliography, the reader documentation.
# Out: data, derived files, backups, logs, the author's working files and self-tests,
#     compiled PDF and LaTeX auxiliaries, libraries.

# --- data: not redistributed, see DATA.md -----------------------------------
/data_inputs/*
# two small files built by the author, shipped (DATA.md)
!/data_inputs/BACI_CEPII_trade/
/data_inputs/BACI_CEPII_trade/*
!/data_inputs/BACI_CEPII_trade/gloria_to_isic3.csv
!/data_inputs/BACI_CEPII_trade/caliendo_parro_2015_thetak/
/data_inputs/BACI_CEPII_trade/caliendo_parro_2015_thetak/*
!/data_inputs/BACI_CEPII_trade/caliendo_parro_2015_thetak/theta_k.csv
/intermediate_outputs/*
# server output under 10 MB, which no provider distributes in this form (DATA.md)
!/intermediate_outputs/tas_ssp2_annual.csv

# --- outputs: only what JMP_V11.tex loads, plus the reference's pinned table ---
/output/*
!/output/values.tex
!/output/values_empirics.tex
!/output/tab_binning.tex
!/output/tab_contrast_grid.tex
!/output/tab_crh_northern.tex
!/output/tab_ctrl_absorption.tex
